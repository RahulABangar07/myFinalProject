                .build();

        // Build the AI Agent exactly as before
        agent = AiServices.builder(TestGeneratorAgent.class)
                .chatLanguageModel(model)
                .build();

        System.out.println("🚀 Starting LOCAL Test Generation Agent for: " + repoPath.toAbsolutePath());
        
        try {
            scanAndGenerateTests(repoPath);
            System.out.println("🎉 Local test generation sweep complete!");
