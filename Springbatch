/**
 * ============================================================
 * GREENPLUM -> AZURE SQL DATA COPY SERVICE
 * ============================================================
 *
 * Architecture:
 *
 *       REST
 *        |
 *        v
 *   Spring Batch Job
 *        |
 *        v
 *   Partitioned Master Step
 *        |
 *        +---- P0 ---- Greenplum -> Azure SQL
 *        +---- P1 ---- Greenplum -> Azure SQL
 *        +---- P2 ---- Greenplum -> Azure SQL
 *        +---- ...
 *        +---- P15 --- Greenplum -> Azure SQL
 *
 * Spring Batch metadata:
 *
 *       Azure PostgreSQL
 *             ^
 *             |
 *       JobRepository
 *
 *
 * Authentication:
 *
 * Greenplum:
 *     username/password
 *
 * Azure SQL:
 *     AKS Workload Identity
 *     DefaultAzureCredential
 *     SQLServerAccessTokenCallback
 *
 * Azure PostgreSQL:
 *     AKS Workload Identity
 *     DefaultAzureCredential
 *     access token as PostgreSQL password
 *
 *
 * IMPORTANT:
 *
 * The reader is @StepScope.
 *
 * Therefore each partition receives its own reader instance.
 * No JdbcPagingItemReader is shared between worker threads.
 *
 * This is important because JDBC paging readers maintain state.
 */
@SpringBootApplication(
        exclude = {
                DataSourceAutoConfiguration.class
        }
)
public class DataCopyApplication {

    public static void main(String[] args) {

        SpringApplication.run(
                DataCopyApplication.class,
                args
        );
    }


